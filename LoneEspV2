-- MENU
-----------------------------------------------
local function createMenu()
    -- Background
    menu.bg = Drawing.new("Square")
    menu.bg.Filled = true
    menu.bg.Color = Color3.fromRGB(10, 20, 40)
    menu.bg.Transparency = 1
    menu.bg.ZIndex = 100
    menu.bg.Visible = true
    
    -- Border
    menu.border = Drawing.new("Square")
    menu.border.Filled = false
    menu.border.Color = C_ACCENT
    menu.border.Transparency = 0.5
    menu.border.ZIndex = 101
    menu.border.Visible = true
    
    -- Title
    menu.title = Drawing.new("Text")
    menu.title.Text = "Lone Esp"
    menu.title.Color = Color3.fromRGB(235, 230, 245)
    menu.title.Outline = true
    menu.title.Font = Drawing.Fonts.SystemBold
    menu.title.Size = 14
    menu.title.ZIndex = 102
    menu.title.Visible = true
    
    -- Toggles
    local toggles = {"iron", "stone", "brimstone", "cloth", "loot", "pack", "sleeper"}
    local labels = {"Iron Ore", "Stone Ore", "Brimstone", "Cloth", "Loot", "Pack", "Sleeper"}
    
    for i, t in ipairs(toggles) do -- low
        -- Checkbox background
        menu[t.."CheckBg"] = Drawing.new("Square")
        menu[t.."CheckBg"].Filled = true
        menu[t.."CheckBg"].Transparency = 0
        menu[t.."CheckBg"].ZIndex = 102
        menu[t.."CheckBg"].Visible = true
        
        -- Checkbox check mark
        menu[t.."Check"] = Drawing.new("Text")
        menu[t.."Check"].Text = "ON"
        menu[t.."Check"].Outline = true
        menu[t.."Check"].Center = true
        menu[t.."Check"].Font = Drawing.Fonts.SystemBold
        menu[t.."Check"].Size = 13
        menu[t.."Check"].ZIndex = 103
        menu[t.."Check"].Visible = false
        
        -- Label
        menu[t.."Label"] = Drawing.new("Text")
        menu[t.."Label"].Text = labels[i]
        menu[t.."Label"].Color = Color3.fromRGB(235, 245, 255)
        menu[t.."Label"].Outline = true
        menu[t.."Label"].Font = Drawing.Fonts.System
        menu[t.."Label"].Size = 13
        menu[t.."Label"].ZIndex = 102
        menu[t.."Label"].Visible = true
        
        -- Row background (for hover)
        menu[t.."RowBg"] = Drawing.new("Square")
        menu[t.."RowBg"].Filled = true
        menu[t.."RowBg"].Transparency = 0.7
        menu[t.."RowBg"].ZIndex = 101
        menu[t.."RowBg"].Visible = false
    end
    
    -- Distance info
    menu.distInfo = Drawing.new("Text")
    menu.distInfo.Text = "Max Distance: 300m"
    menu.distInfo.Color = C_GRAY
    menu.distInfo.Outline = true
    menu.distInfo.Font = Drawing.Fonts.System
    menu.distInfo.Size = 11
    menu.distInfo.ZIndex = 102
    menu.distInfo.Visible = true
end

local function layoutMenu()
    local x, y = menuX, menuY
    local toggles = {"iron", "stone", "brimstone", "cloth", "loot", "pack", "sleeper"}
    
    -- Background ve border
    menu.bg.Position = Vector2.new(x, y)
    menu.bg.Size = Vector2.new(MW, TAB_H + 8 + #toggles * ROW_H + 22)
    
    menu.border.Position = Vector2.new(x, y)
    menu.border.Size = Vector2.new(MW, TAB_H + 8 + #toggles * ROW_H + 22)
    
    -- Title
    menu.title.Position = Vector2.new(x + 10, y + 7)
    
    -- Toggles
    for i, t in ipairs(toggles) do
        local ry = y + TAB_H + 6 + (i - 1) * ROW_H
        local checkbox_x = x + 10
        local checkbox_y = ry + 5
        
        -- Row background
        menu[t.."RowBg"].Position = Vector2.new(x + 2, ry)
        menu[t.."RowBg"].Size = Vector2.new(MW - 4, ROW_H)
        
        -- Checkbox
        menu[t.."CheckBg"].Position = Vector2.new(checkbox_x, checkbox_y)
        menu[t.."CheckBg"].Size = Vector2.new(CHECKBOX_W, CHECKBOX_W)
        
        menu[t.."Check"].Position = Vector2.new(checkbox_x + CHECKBOX_W / 2, checkbox_y + CHECKBOX_W / 2)
        
        -- Label
        menu[t.."Label"].Position = Vector2.new(checkbox_x + CHECKBOX_W + 12, ry + 7)
    end
    
    -- Distance info
    menu.distInfo.Position = Vector2.new(x + 10, y + TAB_H + 8 + #toggles * ROW_H + 4)
end

local function updateMenuVisuals(mx, my)
    local x, y = menuX, menuY
    local toggles = {"iron", "stone", "brimstone", "cloth", "loot", "pack", "sleeper"}
    local states = {IRON_ESP, STONE_ESP, BRIMSTONE_ESP, CLOTH_ESP, LOOT_ESP, PACK_ESP, SLEEPER_ESP}
    
    for i, t in ipairs(toggles) do
        local ry = y + TAB_H + 6 + (i - 1) * ROW_H
        local checkbox_x = x + 10
        local checkbox_y = ry + 5
        
        -- Check state
        local isChecked = states[i]
        menu[t.."CheckBg"].Color = isChecked and C_CHECK_ON or C_CHECK_OFF
        menu[t.."Check"].Visible = isChecked
        
        -- Hover efekti
        if hit(mx, my, x + 2, ry, MW - 4, ROW_H) then
            menu[t.."RowBg"].Visible = true
            menu[t.."RowBg"].Color = C_ACCENT
            menu[t.."Label"].Color = Color3.fromRGB(0, 100, 200)
        else
            menu[t.."RowBg"].Visible = false
            menu[t.."Label"].Color = Color3.fromRGB(255, 255, 255)
        end
    end
end

-----------------------------------------------
-- MOUSE HANDLING
-----------------------------------------------
local function handleMouse()
    local Mouse = LocalPlayer:GetMouse()
    local mx, my = Mouse.X, Mouse.Y
    local m1 = ismouse1pressed() -- low
    
    if m1 and not wasM1 then
        local x, y = menuX, menuY
        local toggles = {"iron", "stone", "brimstone", "cloth", "loot", "pack", "sleeper"}
        
        -- Menu drag
        if hit(mx, my, x, y, MW, TAB_H) then
            dragging = true
            dragOX = mx - menuX
            dragOY = my - menuY
        end
        
        -- Row clicks (entire row tıklanabilir)
        for i, t in ipairs(toggles) do
            local ry = y + TAB_H + 6 + (i - 1) * ROW_H
            if hit(mx, my, x + 2, ry, MW - 4, ROW_H) then
                if t == "iron" then IRON_ESP = not IRON_ESP
                elseif t == "stone" then STONE_ESP = not STONE_ESP
                elseif t == "brimstone" then BRIMSTONE_ESP = not BRIMSTONE_ESP
                elseif t == "cloth" then CLOTH_ESP = not CLOTH_ESP
                elseif t == "loot" then LOOT_ESP = not LOOT_ESP
                elseif t == "pack" then PACK_ESP = not PACK_ESP
                elseif t == "sleeper" then SLEEPER_ESP = not SLEEPER_ESP
                end
                break
            end
        end
    end
    
    if m1 and dragging then
        menuX = mx - dragOX
        menuY = my - dragOY
        layoutMenu()
    end
    
    if not m1 then
        dragging = false
    end
    wasM1 = m1
    
    return mx, my
end

-----------------------------------------------
-- MAIN LOOP
-----------------------------------------------
local function main()
    createMenu()
    layoutMenu()
    collectResources()
    
    print("[ESP] Loaded | Loot/Pack/Sleeper aktif | F2=Toggle")
    
    while true do
        -- F2 toggle menu
        if iskeypressed(VK_F2) then
            if not f2Down then
                f2Down = true
                MENU_ON = not MENU_ON
                menu.bg.Visible = MENU_ON
                menu.border.Visible = MENU_ON
                menu.title.Visible = MENU_ON
                menu.distInfo.Visible = MENU_ON
                local toggles = {"iron", "stone", "brimstone", "cloth", "loot", "pack", "sleeper"}
                for _, t in ipairs(toggles) do -- lo
                    menu[t.."CheckBg"].Visible = MENU_ON
                    menu[t.."Label"].Visible = MENU_ON
                end
            end
        else
            f2Down = false
        end
        
        -- Update ESP
        updateESP()
        
        -- Handle menu
        if MENU_ON then
            local mx, my = handleMouse()
            updateMenuVisuals(mx, my)
        end
        
        task.wait(RATE)
    end
end

-- Auto-collect her 20 saniye
task.spawn(function()
    while true do
        task.wait(20)
        collectResources()
    end
end)

task.spawn(main)

    Resource ESP - Dandy's World Style (Matcha LuaVM)
    Fixed: Cleanup, Loot/Pack/Sleeper, Better toggles
]]

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Feature toggles (ALL OFF BY DEFAULT)
local IRON_ESP = false
local STONE_ESP = false
local BRIMSTONE_ESP = false
local CLOTH_ESP = false
local LOOT_ESP = false
local PACK_ESP = false
local SLEEPER_ESP = false
local MENU_ON = true
local MAX_DIST = 300
local RATE = 0.016

-- Colors
local C_IRON = Color3.fromRGB(255, 140, 0)
local C_STONE = Color3.fromRGB(0, 220, 255)
local C_BRIMSTONE = Color3.fromRGB(255, 0, 60)
local C_CLOTH = Color3.fromRGB(0, 255, 100)
local C_LOOT = Color3.fromRGB(255, 255, 0)
local C_PACK = Color3.fromRGB(255, 165, 0)
local C_SLEEPER = Color3.fromRGB(255, 0, 255)
local C_GRAY = Color3.fromRGB(180, 180, 180)
local C_ACCENT = Color3.fromRGB(0, 150, 255)
local C_CHECK_ON = Color3.fromRGB(0, 200, 255)
local C_CHECK_OFF = Color3.fromRGB(50, 80, 120)

-- Menu dimensions
local MW = 260
local TAB_H = 28
local ROW_H = 28
local CHECKBOX_W = 18
local menuX = 100
local menuY = 100
local menu = {}

-- Object Pool
local espPool = {}
local espObjects = {}

-- VK
local VK_F2 = 0x71

-- State
local f2Down = false
local dragging = false
local dragOX, dragOY = 0, 0
local wasM1 = false

-----------------------------------------------
-- HELPERS
-----------------------------------------------
local function clamp(v, a, b)
    if v < a then return a end
    if v > b then return b end
    return v
end

local function dist3d(a, b)
    local dx, dy, dz = a.X - b.X, a.Y - b.Y, a.Z - b.Z
    return math.sqrt(dx*dx + dy*dy + dz*dz)
end

local function hit(mx, my, x, y, w, h)
    return mx >= x and mx <= x + w and my >= y and my <= y + h
end

local function getPlayerPos()
    local c = LocalPlayer.Character
    if not c then return nil end
    local h = c:FindFirstChild("HumanoidRootPart")
    return h and h.Position or nil
end

-----------------------------------------------
-- CLEANUP
-----------------------------------------------
local function cleanupESPPool()
    for i = 1, #espPool do
        pcall(function()
            espPool[i].box:Remove()
            espPool[i].fill:Remove()
            espPool[i].name:Remove()
            espPool[i].dist:Remove()
        end)
    end
    espPool = {}
end

-----------------------------------------------
-- ESP DRAWING OBJECT POOL
-----------------------------------------------
local function makeESPDraw()
    local d = {}
    d.box = Drawing.new("Square")
    d.box.Filled = false
    d.box.Visible = false
    d.box.Transparency = 1
    d.box.ZIndex = 10
    
    d.fill = Drawing.new("Square")
    d.fill.Filled = true
    d.fill.Visible = false
    d.fill.Transparency = 0.15
    d.fill.ZIndex = 9
    
    d.name = Drawing.new("Text")
    d.name.Outline = true
    d.name.Center = true
    d.name.Font = Drawing.Fonts.SystemBold
    d.name.Size = 14
    d.name.Visible = false
    d.name.ZIndex = 11
    
    d.dist = Drawing.new("Text")
    d.dist.Color = C_GRAY
    d.dist.Outline = true
    d.dist.Center = true
    d.dist.Font = Drawing.Fonts.System
    d.dist.Size = 12
    d.dist.Visible = false
    d.dist.ZIndex = 11
    
    return d
end

local function hideESP(d)
    d.box.Visible = false
    d.fill.Visible = false
    d.name.Visible = false
    d.dist.Visible = false
end

-----------------------------------------------
-- OBJECT SCANNER
-----------------------------------------------
local function getResourceType(objName)
    if objName == "Iron Ore" then return "iron" end
    if objName == "Stone Ore" or objName == "Stone Ore Sand" then return "stone" end
    if objName == "Brimstone Ore" then return "brimstone" end
    if objName == "ClothPlant" then return "cloth" end
    return nil
end

local function getResourceColor(objType)
    if objType == "iron" then return C_IRON end
    if objType == "stone" then return C_STONE end
    if objType == "brimstone" then return C_BRIMSTONE end
    if objType == "cloth" then return C_CLOTH end
    if objType == "loot" then return C_LOOT end
    if objType == "pack" then return C_PACK end
    if objType == "sleeper" then return C_SLEEPER end
    return C_LOOT
end

local function getResourceLabel(objType, objName)
    if objType == "iron" then return "Iron" end
    if objType == "stone" then return objName == "Stone Ore Sand" and "Sand" or "Stone" end
    if objType == "brimstone" then return "Brimstone" end
    if objType == "cloth" then return "Cloth" end
    if objType == "loot" then return "Loot" end
    if objType == "pack" then return "Pack" end
    if objType == "sleeper" then return "Sleeper" end
    return objName
end

local function isESPEnabled(objType)
    if objType == "iron" then return IRON_ESP end
    if objType == "stone" then return STONE_ESP end
    if objType == "brimstone" then return BRIMSTONE_ESP end
    if objType == "cloth" then return CLOTH_ESP end
    if objType == "loot" then return LOOT_ESP end
    if objType == "pack" then return PACK_ESP end
    if objType == "sleeper" then return SLEEPER_ESP end
    return false
end

local function collectResources()
    espObjects = {}
    
    -- Iron Ore
    local resources = Workspace:FindFirstChild("Resources")
    if resources then
        for _, obj in pairs(resources:GetChildren()) do
            local objType = getResourceType(obj.Name)
            if objType then
                local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    table.insert(espObjects, {
                        obj = obj,
                        part = part,
                        type = objType,
                        label = getResourceLabel(objType, obj.Name),
                        color = getResourceColor(objType)
                    })
                end
            end
        end
    end
    
    -- Cloth Plants
    local clothPlants = Workspace:FindFirstChild("ClothPlants")
    if clothPlants then
        for _, obj in pairs(clothPlants:GetChildren()) do
            if obj.Name == "ClothPlant" then
                local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    table.insert(espObjects, {
                        obj = obj,
                        part = part,
                        type = "cloth",
                        label = "Cloth",
                        color = C_CLOTH
                    })
                end
            end
        end
    end
    
    -- Dropped Items (Loot)
    local dropped = Workspace:FindFirstChild("Dropped")
    if dropped then
        for _, obj in pairs(dropped:GetChildren()) do
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                table.insert(espObjects, {
                    obj = obj,
                    part = part,
                    type = "loot",
                    label = "Loot",
                    color = C_LOOT
                })
            end
        end
    end
    
    -- Dropped Packs
    local droppedPacks = Workspace:FindFirstChild("DroppedPacks")
    if droppedPacks then
        for _, obj in pairs(droppedPacks:GetChildren()) do
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                table.insert(espObjects, {
                    obj = obj,
                    part = part,
                    type = "pack",
                    label = "Pack",
                    color = C_PACK
                })
            end
        end
    end
    
    -- Offline Players (Sleepers)
    local offlinePlayers = Workspace:FindFirstChild("OfflinePlayers")
    if offlinePlayers then
        for _, obj in pairs(offlinePlayers:GetChildren()) do
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                table.insert(espObjects, {
                    obj = obj,
                    part = part,
                    type = "sleeper",
                    label = "Sleeper",
                    color = C_SLEEPER
                })
            end
        end
    end
end

-----------------------------------------------
-- ESP UPDATE
-----------------------------------------------
local function updateESP()
    local pp = getPlayerPos()
    if not pp then
        for i = 1, #espPool do
            hideESP(espPool[i])
        end
        return 0
    end
    
    local oc = #espObjects
    while #espPool < oc do
        espPool[#espPool + 1] = makeESPDraw()
    end
    
    for i = oc + 1, #espPool do
        hideESP(espPool[i])
    end
    
    local visibleCount = 0
    for i = 1, oc do
        local obj = espObjects[i]
        local d = espPool[i]
        
        if obj.part and isESPEnabled(obj.type) then
            local di = dist3d(pp, obj.part.Position)
            
            -- MAX 300 METRE CHECK
            if di > MAX_DIST then
                hideESP(d)
            else
                local sp, vis = WorldToScreen(obj.part.Position)
                if vis then
                    local dis = math.floor(di)
                    local bs = clamp(2000 / (di + 1), 20, 80)
                    
                    d.box.Position = Vector2.new(sp.X - bs / 2, sp.Y - bs / 2)
                    d.box.Size = Vector2.new(bs, bs)
                    d.box.Color = obj.color
                    d.box.Visible = true
                    
                    d.fill.Position = Vector2.new(sp.X - bs / 2, sp.Y - bs / 2)
                    d.fill.Size = Vector2.new(bs, bs)
                    d.fill.Color = obj.color
                    d.fill.Visible = true
                    
                    d.name.Position = Vector2.new(sp.X, sp.Y - bs / 2 - 18)
                    d.name.Text = obj.label
                    d.name.Color = obj.color
                    d.name.Visible = true
                    
                    d.dist.Position = Vector2.new(sp.X, sp.Y + bs / 2 + 4)
                    d.dist.Text = "[" .. tostring(dis) .. "m]"
                    d.dist.Visible = true
                    
                    visibleCount = visibleCount + 1
                else
                    hideESP(d)
                end
            end
        else
            hideESP(d)
        end
    end
    
    return visibleCount
end

